# Theme and Window
theme = Arthur
background-opacity = 0.90
background-blur = 20
macos-titlebar-style = hidden
window-padding-x = 10
window-padding-y = 10

# Font
font-family = FiraCode Nerd Font
font-size = 13
font-thicken = true
adjust-cell-height = 10%

# Behavior
copy-on-select = true
confirm-close-surface = false

# Split creation
keybind = super+shift+e=new_split:right
keybind = super+shift+o=new_split:down

# Navigation
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:down
keybind = super+ctrl+k=goto_split:up
keybind = super+ctrl+l=goto_split:right

# Zoom & Management
keybind = super+z=toggle_split_zoom
keybind = super+w=close_surface
